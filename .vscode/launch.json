{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Rebuild database (load_db)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_db.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Explore the data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/explore.py",
      "args": ["roles"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
