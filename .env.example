# Copy to .env and fill in. .env is gitignored -- never commit it.

# Build-time only. The API never touches a database at request time: it
# reads precomputed profiles from data/profiles/. This is used by
# scripts/load_db.py, extract_skills.py and build_profiles.py.
# Leave unset to use the local SQLite file (see analyzer/db.py).
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Comma-separated origins allowed to call the API. Defaults to the Vite dev
# server; set this to the deployed frontend URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
