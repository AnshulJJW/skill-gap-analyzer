# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# env / secrets
.env
.env.local

# personal input — never commit your own resume
resumes/*
!resumes/.gitkeep
!resumes/example.txt

# generated artifacts
data/postings.csv
*.db

# data/profiles/ is deliberately NOT ignored. It is 52KB of precomputed
# role demand, and it is what the API loads at startup -- without it a fresh
# clone cannot serve a single request. The 682MB of raw CSVs that produced
# it stay out (data/raw/), so a clone can RUN the tool but must fetch the
# Kaggle data to rebuild the profiles from scratch.

# node / vite
node_modules/
web/dist/

# editors / os
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db

# raw dataset downloads (large; snapshots are curated into data/ instead)
data/raw/

# local database
data/skillgap.db
